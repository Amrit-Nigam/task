# Port the API listens on. Most hosts inject this themselves — leave it unset
# there rather than hard-coding a value the platform will not route to.
PORT=4000

# Comma-separated origins allowed to call the API. UNSET MEANS ANY ORIGIN.
#
# Note that Vercel preview deployments each get their own hostname
# (project-git-branch-user.vercel.app), so listing only the production domain
# blocks every preview. This API is public, read-only and unauthenticated, so
# leaving it open is defensible — but set it once the service gains writes.
CORS_ORIGIN=https://your-pokedex.vercel.app

# Override only if you proxy or mirror PokéAPI.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
