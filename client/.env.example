# Origin of the Pokédex API — no trailing slash, and no "/api" (the client
# appends that itself).
#
# Leave unset in development: Vite proxies /api to http://localhost:4000.
# Set it for a deployed client, e.g. on Vercel.
#
# Read by Vite at BUILD time and inlined into the bundle, so changing it on the
# host does nothing until you redeploy. Every VITE_* variable ships to the
# browser — never put a secret in one.
VITE_API_BASE=https://your-pokedex-api.onrender.com

# Development only: where `npm run dev` proxies /api to. Override if the local
# server is not on port 4000.
VITE_API_PROXY=http://localhost:4000
